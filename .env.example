# =============================================================================
# Copy to .env and fill in the LLM keys. Everything else works as-is.
#   cp .env.example .env
# =============================================================================

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

LLM_PROVIDER_ORDER=groq,gemini,openrouter
LLM_FAST_MODEL_GEMINI=gemini-3.1-flash-lite
LLM_STRONG_MODEL_GEMINI=gemini-3.5-flash
LLM_FAST_MODEL_GROQ=llama-3.1-8b-instant
LLM_STRONG_MODEL_GROQ=llama-3.3-70b-versatile
LLM_FAST_MODEL_OPENROUTER=openai/gpt-oss-20b:free
LLM_STRONG_MODEL_OPENROUTER=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free-tier rate limits, used to seed the client-side token buckets.
GEMINI_RPM=15
GROQ_RPM=25
OPENROUTER_RPM=20

# Tokens/minute
GEMINI_TPM=250000
GEMINI_TPM_STRONG=250000
GROQ_TPM=6000
GROQ_TPM_STRONG=12000
OPENROUTER_TPM=200000
OPENROUTER_TPM_STRONG=200000

# LLM failover, retries and budgeting 
LLM_MAX_ATTEMPTS_PER_PROVIDER=2
LLM_FAILOVER_WAIT_SECONDS=1.5
LLM_OUTPUT_RESERVE_TOKENS=700
LLM_DEFAULT_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=45.0
LLM_STREAM_TIMEOUT_SECONDS=30.0

LLM_DEFAULT_TPM=30000

LLM_MAX_RETRY_AFTER_SECONDS=30.0
LLM_MAX_BACKOFF_SECONDS=20.0

LLM_BUCKET_BURST=5
LLM_BUCKET_TIMEOUT_SECONDS=30.0
LLM_BUDGET_TIMEOUT_SECONDS=60.0

LLM_WAIT_SLICE_SECONDS=0.5

LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=60.0
LLM_BREAKER_MAX_COOLDOWN_SECONDS=900.0

APPROX_CHARS_PER_TOKEN=4

# Postgres 
POSTGRES_USER=nawaloka
POSTGRES_PASSWORD=nawaloka_dev
POSTGRES_DB=nawaloka
POSTGRES_PORT=5433
CHATBOT_RO_PASSWORD=chatbot_ro_dev

DATABASE_URL=postgresql://nawaloka:nawaloka_dev@localhost:5433/nawaloka
DATABASE_RO_URL=postgresql://chatbot_ro:chatbot_ro_dev@localhost:5433/nawaloka

DB_MAX_ROWS=200
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Qdrant 
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nawaloka_web
QDRANT_FAQ_COLLECTION=faq_curated
QDRANT_CACHE_COLLECTION=faq_cache
QDRANT_ONTOLOGY_COLLECTION=symptom_ontology
QDRANT_TIMEOUT_SECONDS=60
QDRANT_INDEX_BATCH_SIZE=64
QDRANT_SCROLL_LIMIT=1000

# Retrieval 
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_PREFETCH_LIMIT=30
RETRIEVAL_FUSION_LIMIT=12
RETRIEVAL_TOP_K=5
ONNX_THREADS=0
RETRIEVAL_SCORE_FLOOR=0.02
RERANK_DOC_CHARS=1200

# Routing 
#   below MIN   the model is guessing, so ask both sources
#   below HIGH  widen only when signals show a transactional AND a descriptive part
ROUTER_MIN_CONFIDENCE=0.50
ROUTER_HIGH_CONFIDENCE=0.80

ROUTER_FALLBACK_CONFIDENCE=0.50
ROUTER_ERROR_FALLBACK_CONFIDENCE=0.40
ROUTER_MAX_TOKENS=400
ROUTER_RATIONALE_MAX_CHARS=400

ROUTER_HISTORY_TURNS=2
ROUTER_HISTORY_ANSWER_CHARS=200

# Deterministic signals / gazetteer 

# The gazetteer is built from the live database (every doctor, specialty, lab test and package name), so it cannot drift from the data.
SIGNALS_SHARED_WORD_CUTOFF=2
SIGNALS_WORD_MIN_LEN=5
SIGNALS_DOCTOR_WORD_MIN_LEN=4
SIGNALS_LAB_WORD_MIN_LEN=6
SIGNALS_ALIAS_MIN_LEN=3
SIGNALS_TERM_MIN_LEN=3

# Symptom ontology (symptom -> specialty) 
ONTOLOGY_TOP_K=4
ONTOLOGY_MATCH_FLOOR=0.65
ONTOLOGY_RELATIVE_MARGIN=0.10
ONTOLOGY_COMPLAINT_FLOOR=0.80
ONTOLOGY_DECISIVE_MARGIN=0.05
ONTOLOGY_DOCTOR_TERM_MIN_LEN=4

# FAQ fast path and semantic cache 
FAQ_CURATED_THRESHOLD=0.75
FAQ_CACHE_THRESHOLD=0.88
FAQ_CACHE_TTL_SECONDS=3600

# SQL branch 
SQL_MAX_ATTEMPTS=3
SQL_TOOL_CHOICE_MAX_TOKENS=400
SQL_TOOL_REASON_MAX_CHARS=200
SQL_BROADEN_MAX_ATTEMPT=1
SQL_NAME_SIMILARITY=0.3
SQL_SPECIALTY_THRESHOLD=0.80
SQL_PREFIX_MATCH_SCORE=0.95
SQL_PREFIX_MIN_LEN=4
SQL_MIN_WORD_LEN=3
SQL_DEFAULT_ROW_LIMIT=20
SQL_MAX_ROW_LIMIT=50
SQL_DOCTOR_SCHEDULE_LIMIT=5
SQL_SPECIALTY_LIST_LIMIT=50
SQL_SUGGEST_SPECIALTY_LIMIT=20

# Text-to-SQL fallback 
TEXT2SQL_MAX_TOKENS=1200
TEXT2SQL_RELAX_MAX_TOKENS=400
TEXT2SQL_EXPLANATION_MAX_CHARS=300
TEXT2SQL_MAX_ROWS_IN_PAYLOAD=50

# Synthesis 
SYNTHESIS_MAX_TOKENS=8000
SYNTHESIS_RETRY_MAX_TOKENS=16000
SYNTHESIS_TEMPERATURE=0.2
SYNTHESIS_MAX_ROWS_IN_PROMPT=25
SYNTHESIS_MAX_DOC_CHARS=1100
SYNTHESIS_HISTORY_TURNS=2
SYNTHESIS_HISTORY_ANSWER_CHARS=200
SYNTHESIS_FALLBACK_CITATIONS=3

# Follow-up rewriting 
CONTEXTUALIZE_MAX_TOKENS=300
CONTEXTUALIZE_MAX_FOCUS_CHARS=1200
CONTEXTUALIZE_HISTORY_TURNS=5
CONTEXTUALIZE_MIN_REWRITE_CHARS=6
CONTEXTUALIZE_MIN_REWRITE_RATIO=3

# Conversation memory 
MEMORY_MAX_HISTORY_TURNS=20
MEMORY_SUMMARY_HISTORY_TURNS=10
MEMORY_SUMMARY_AFTER_TURNS=6
MEMORY_SUMMARY_EVERY_N_TURNS=4
MEMORY_MAX_SUMMARY_WORDS=120
MEMORY_SUMMARY_MAX_TOKENS=400
MEMORY_SUMMARY_ANSWER_CHARS=200
MEMORY_VALUE_MAX_CHARS=500

# Routing decision log 
DECISION_LOG_MAX_QUERY_CHARS=2000
DECISION_LOG_MAX_RATIONALE_CHARS=1000
DECISION_LOG_RECENT_LIMIT=50

# Scraper 
SCRAPE_SITEMAP_URL=https://www.nawaloka.com/sitemap.xml
SCRAPE_CONCURRENCY=3
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_TIMEOUT_MS=45000
SCRAPE_MIN_CHARS=300
SCRAPE_USER_AGENT=NawalokaAgentBot/1.0 (technical assignment; contact: candidate) Chrome/131 Playwright
SCRAPE_MIN_RENDERED_CHARS=400
SCRAPE_MAX_ATTEMPTS=3

# Extraction 
EXTRACT_BOILERPLATE_RATIO=0.35
EXTRACT_MIN_BLOCK_CHARS=3
EXTRACT_CATALOGUE_MIN_OPTIONS=25

# Chunking (rough tokens, see APPROX_CHARS_PER_TOKEN) 
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=700
CHUNK_MIN_TOKENS=60
CHUNK_OVERLAP_TOKENS=80
CHUNK_CATALOGUE_BATCH=40

# Startup seeding 
SEED_ON_STARTUP=true
SEED_WAIT_TIMEOUT=120
SEED_POLL_SECONDS=2.0

# Feature flags (each bonus feature can be disabled independently) 
ENABLE_FAQ_FASTPATH=true
ENABLE_SEMANTIC_CACHE=true
ENABLE_MEMORY=true
ENABLE_RERANK=true
ENABLE_TEXT2SQL_FALLBACK=true
ENABLE_SQL_VECTOR_FALLBACK=true
ENABLE_DECISION_LOG=true

# App 
LOG_LEVEL=INFO
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:3000
API_MAX_MESSAGE_CHARS=2000
API_STREAM_WORDS_PER_CHUNK=4
API_STREAM_DELAY_SECONDS=0.02
