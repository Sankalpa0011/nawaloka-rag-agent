# =============================================================================
# Copy to .env and fill in the LLM keys. Everything else works as-is.
#   cp .env.example .env
# =============================================================================

# --- LLM providers -----------------------------------------------------------
# At least ONE of these is required. The provider layer fails over automatically
# in the order given by LLM_PROVIDER_ORDER, so the app runs fine with only one.
#   Gemini (free tier): https://aistudio.google.com/apikey
#   Groq   (free tier): https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

LLM_PROVIDER_ORDER=groq,gemini
# gemini-2.x is unavailable on newly-created AI Studio accounts
# (404 'no longer available to new users' / 429 quota). Verify with
#   python -m app.llm.check_models
LLM_FAST_MODEL_GEMINI=gemini-3.1-flash-lite
LLM_STRONG_MODEL_GEMINI=gemini-3.5-flash
LLM_FAST_MODEL_GROQ=llama-3.1-8b-instant
LLM_STRONG_MODEL_GROQ=llama-3.3-70b-versatile

# Free-tier rate limits, used to seed the client-side token buckets.
# Verify against your account's current quota before a demo.
GEMINI_RPM=15
GROQ_RPM=25

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=nawaloka
POSTGRES_PASSWORD=nawaloka_dev_pw
POSTGRES_DB=nawaloka
# 5433 on the host to avoid clashing with a local Postgres on 5432.
POSTGRES_PORT=5433
CHATBOT_RO_PASSWORD=chatbot_ro_dev_pw

# Owner connection: checkpoints, routing logs, user memory.
DATABASE_URL=postgresql://nawaloka:nawaloka_dev_pw@localhost:5433/nawaloka
# Least-privilege connection: EVERY agent-issued SQL query goes through this.
DATABASE_RO_URL=postgresql://chatbot_ro:chatbot_ro_dev_pw@localhost:5433/nawaloka

# --- Qdrant ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nawaloka_web
QDRANT_FAQ_COLLECTION=faq_curated
QDRANT_CACHE_COLLECTION=faq_cache

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_PREFETCH_LIMIT=30
# Candidates sent to the cross-encoder. Reranking dominates retrieval latency
# and scales linearly with this. 12 x 1200 chars ~ 1.0 s; 20 x 1200 ~ 1.8 s.
RETRIEVAL_FUSION_LIMIT=12
RETRIEVAL_TOP_K=5
# Below this rerank score the agent abstains instead of citing weak chunks.
# Calibrated empirically - see docs/retrieval-calibration.md
RETRIEVAL_SCORE_FLOOR=0.02

# --- Scraper -----------------------------------------------------------------
SCRAPE_SITEMAP_URL=https://www.nawaloka.com/sitemap.xml
SCRAPE_CONCURRENCY=3
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_TIMEOUT_MS=45000
# A page yielding fewer than this many characters is treated as a scrape
# failure, not as an empty page. nawaloka.com is a client-rendered SPA, so
# silent under-extraction is the single most likely way ingestion breaks.
SCRAPE_MIN_CHARS=300

# --- Feature flags (each bonus feature can be disabled independently) --------
ENABLE_FAQ_FASTPATH=true
ENABLE_SEMANTIC_CACHE=true
ENABLE_MEMORY=true
ENABLE_RERANK=true
ENABLE_TEXT2SQL_FALLBACK=true

# --- App ---------------------------------------------------------------------
LOG_LEVEL=INFO
# 8001 rather than 8000: 8000 is a very common default and was
# already taken on the development machine.
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:3000
