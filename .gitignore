# --- Data --------------------------------------------------------------------
# data/raw/ is deliberately COMMITTED: it is the cached rendered HTML that lets
# the whole vector index be rebuilt offline, with no network access and no
# dependence on the live site still looking the same. See app/ingest/scrape.py.
backend/data/extracted/
backend/data/chunks/
backend/.embeddings_cache/
backend/evals/.llm_cache/

